# ============================================================
# Variables de entorno para docker-compose (infraestructura)
# Copiar este archivo como .env y ajustar valores en producción
# ============================================================

# PostgreSQL
POSTGRES_DB=rednorte_waitlist
POSTGRES_USER=rednorte
POSTGRES_PASSWORD=rednorte_secret
POSTGRES_PORT=5432

# Kafka
KAFKA_PORT=9092
KAFKA_UI_PORT=8090

# Spring Boot (cuando se corre localmente, apunta a localhost)
DB_URL=jdbc:postgresql://localhost:5432/rednorte_waitlist
DB_USERNAME=rednorte
DB_PASSWORD=rednorte_secret
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
HIKARI_MAX_POOL_SIZE=5
HIKARI_MIN_IDLE=2
SERVER_PORT=8080
